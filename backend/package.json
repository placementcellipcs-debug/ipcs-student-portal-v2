{
  "name": "ipcs-student-portal-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Express API for the IPCS Student Portal",
  "main": "server.js",
  "scripts": {
    "build": "echo No build step required",
    "start": "node server.js",
    "test": "node --test",
    "db:check": "node scripts/check-mysql.js",
    "db:check-student-auth": "node scripts/check-mysql-student-auth.js",
    "db:check-student-profile": "node scripts/check-mysql-student-profile.js",
    "db:preview-student-drives": "node scripts/load-student-drives.js",
    "db:preview-gamepal": "node scripts/preview-gamepal.js",
    "db:load-student-drives": "node scripts/load-student-drives.js --apply",
    "db:check-student-drives": "node scripts/check-mysql-student-drives.js",
    "db:check-applications": "node scripts/check-mysql-applications.js",
    "db:migrate": "node scripts/migrate-mysql.js",
    "db:import-sheets": "node ../database/scripts/import-sheet-snapshots.js --apply",
    "db:verify-sheets": "node scripts/verify-sheet-snapshot.js",
    "db:quality-sheets": "node scripts/check-sheet-data-quality.js",
    "db:preview-reference-data": "node scripts/load-reference-data.js",
    "db:load-reference-data": "node scripts/load-reference-data.js --apply",
    "db:load-staff": "node scripts/load-staff-users.js --apply",
    "db:preview-students": "node scripts/load-student-profiles.js",
    "db:load-students": "node scripts/load-student-profiles.js --apply",
    "db:preview-placement-tracker": "node scripts/load-placement-tracker.js",
    "db:load-placement-tracker": "node scripts/load-placement-tracker.js --apply",
    "db:preview-placement-outcomes": "node scripts/load-placement-outcomes.js",
    "db:load-placement-outcomes": "node scripts/load-placement-outcomes.js --apply",
    "db:preview-targets": "node scripts/load-placement-targets.js",
    "db:load-targets": "node scripts/load-placement-targets.js --apply",
    "db:preview-companies": "node scripts/load-company-directory.js",
    "db:load-companies": "node scripts/load-company-directory.js --apply",
    "db:preview-delete-requests": "node scripts/load-delete-requests.js",
    "db:load-delete-requests": "node scripts/load-delete-requests.js --apply",
    "db:preview-assets": "node scripts/load-asset-management.js",
    "db:load-assets": "node scripts/load-asset-management.js --apply",
    "db:preview-student-leave": "node scripts/load-student-leave-requests.js",
    "db:load-student-leave": "node scripts/load-student-leave-requests.js --apply",
    "db:check-student-leave": "node scripts/check-mysql-student-leave.js",
    "db:preview-support-issues": "node scripts/load-support-issues.js",
    "db:load-support-issues": "node scripts/load-support-issues.js --apply",
    "db:check-support-issues": "node scripts/check-mysql-support-issues.js"
  },
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "googleapis": "^182.0.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "node-cache": "^5.1.2",
    "nodemailer": "^10.0.10"
  }
}
