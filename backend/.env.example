# Primary spreadsheet for the IPCS Placement Ecosystem portal.
SPREADSHEET_ID=1Dyz7hu53KyOV5rC9YU4y7t0GDGUtkfIqrMH1mTZtLFk

# Nodemailer SMTP fallback. For Gmail, create an App Password for this account.
EMAIL_USER=placementcell.ipcs@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM=IPCS Global <placementcell.ipcs@gmail.com>
# Optional custom SMTP provider. Leave blank to use Gmail SMTP on port 465.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true

# Public reset-link origin. Set this explicitly in Render; loopback FRONTEND_URL values are ignored.
RESET_PASSWORD_BASE_URL=https://ipcstalenzo.com

# Apps Script HTTPS mail gateway used for student password reset emails.
# Deploy backend/PasswordResetMailer.gs as a web app from placementcell.ipcs@gmail.com.
APPS_SCRIPT_MAIL_URL=https://script.google.com/macros/s/PRIMARY_DEPLOYMENT_ID/exec
# Optional second deployment URL; create it from the same Apps Script project.
APPS_SCRIPT_MAIL_FALLBACK_URL=https://script.google.com/macros/s/SECONDARY_DEPLOYMENT_ID/exec
# Use the same random secret in Render's environment and Apps Script Script properties.
APPS_SCRIPT_MAIL_SECRET=replace-with-a-long-random-secret
