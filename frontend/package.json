{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:native": "vite build --mode native",
    "lint": "eslint .",
    "preview": "vite preview",
    "start-desktop": "electron .",
    "build-desktop": "electron-builder",
    "tauri": "tauri",
    "tauri:icons": "tauri icon public/icons/app-icon-512.png --output src-tauri/icons",
    "tauri:dev": "npm run tauri:icons && tauri dev",
    "tauri:android:init": "tauri android init",
    "tauri:build": "npm run tauri:icons && tauri build",
    "tauri:android:apk": "npm run tauri:icons && tauri android build --apk",
    "tauri:ios:init": "tauri ios init",
    "tauri:ios": "npm run tauri:icons && tauri ios build"
  },
  "build": {
    "appId": "com.talenzo.app",
    "productName": "Talenzo",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": "nsis",
      "icon": "src-tauri/icons/icon.ico"
    },
    "nsis": {
      "installerIcon": "src-tauri/icons/icon.ico",
      "uninstallerIcon": "src-tauri/icons/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "src-tauri/icons/icon.icns"
    },
    "files": [
  "dist/**/*",
  "main.cjs",
  "splash.html",
  "public/icons/talenzo-brand-mark.png",
  "src-tauri/icons/icon.ico"
]
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@phosphor-icons/react": "^2.1.10",
    "axios": "^1.20.0",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-easy-crop": "^6.2.3",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "vite": "^8.3.0"
  }
}
